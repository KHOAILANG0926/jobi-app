{
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit)",
      "Bash(vercel --version)",
      "Bash(vercel whoami *)",
      "Bash(gh --version)",
      "Bash(ipconfig)",
      "Bash(findstr /i \"IPv4\")",
      "PowerShell(\\(Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.InterfaceAlias -notmatch 'Loopback' -and $_.IPAddress -ne '127.0.0.1' }\\).IPAddress)",
      "Skill(fewer-permission-prompts)",
      "Skill(fewer-permission-prompts:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-reminder.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-check.mjs\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
