{
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    { "source": "/api/admin/reprocess-jobs", "destination": "/api/admin?action=reprocess-jobs" },
    {
      "source": "/viec-lam/tuyen-gap",
      "destination": "/api/ssr"
    },
    {
      "source": "/viec-lam/tim-kiem",
      "destination": "/api/ssr"
    },
    {
      "source": "/viec-lam/:id((?!da-luu$|da-xem$|phu-hop$|goi-y$|tuyen-gap$|tim-kiem$).+)",
      "destination": "/api/ssr"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ssr.js": {
      "includeFiles": "{dist/**,node_modules/react-router/dist/**}"
    },
    "api/sitemap.xml.js": {
      "includeFiles": "{dist/**,node_modules/react-router/dist/**}"
    },
    "api/location-hook.js": {
      "includeFiles": "dist/api-lib/**"
    },
    "api/admin.js": {
      "includeFiles": "dist/api-lib/**"
    }
  }
}
